{
  "name": "ft-paper",
  "displayName": "ft-paper and ft-paper-night",
  "description": "Light ft-paper and dark ft-paper-night themes generated from the palettes of camillehdl.dev.",
  "version": "0.3.0",
  "publisher": "CamilleHodoul",
  "author": "Camille Hodoul",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "https://github.com/camille-hdl/vscode-ft-paper.git"
  },
  "homepage": "https://github.com/camille-hdl/vscode-ft-paper#readme",
  "bugs": {
    "url": "https://github.com/camille-hdl/vscode-ft-paper/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "light",
    "paper",
    "ft-paper",
    "dark",
    "night",
    "ft-paper-night"
  ],
  "galleryBanner": {
    "color": "#1f1915",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "ft-paper",
        "uiTheme": "vs",
        "path": "./themes/ft-paper-color-theme.json"
      },
      {
        "label": "ft-paper-night",
        "uiTheme": "vs-dark",
        "path": "./themes/ft-paper-night-color-theme.json"
      }
    ]
  },
  "scripts": {
    "palette": "node --no-warnings scripts/fetch-palette.mjs",
    "build": "node --no-warnings scripts/build.mjs",
    "check": "node --no-warnings scripts/check.mjs",
    "vscode:prepublish": "npm run build && npm run check"
  }
}
